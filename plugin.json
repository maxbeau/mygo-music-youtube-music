{
  "id": "youtube-music",
  "name": "YouTube Music",
  "version": "0.6.0",
  "minAppVersion": "0.1.31",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "music.youtube.com",
      "s.youtube.com",
      "api.betterlyrics.org",
      "lrclib.net",
      "lyrics.kugou.com",
      "music.163.com"
    ],
    "process": [
      "ffmpeg",
      "yt-dlp",
      "/opt/homebrew/bin/ffmpeg",
      "/opt/homebrew/bin/yt-dlp",
      "/usr/local/bin/ffmpeg",
      "/usr/local/bin/yt-dlp"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart",
      "group": "explore"
    },
    {
      "title": "New Releases",
      "page": "new",
      "icon": "star",
      "group": "explore"
    },
    {
      "title": "Moods & Genres",
      "page": "moods",
      "icon": "radio",
      "group": "explore"
    },
    {
      "builtin": "stations"
    },
    {
      "builtin": "liked"
    },
    {
      "builtin": "savedAlbums"
    },
    {
      "title": "Artists",
      "page": "artists",
      "icon": "artist",
      "group": "library"
    }
  ],
  "lyricSources": [
    {
      "id": "YouTube",
      "name": "YouTube"
    },
    {
      "id": "BetterLyrics",
      "name": "BetterLyrics"
    },
    {
      "id": "LRCLIB",
      "name": "LRCLIB"
    },
    {
      "id": "KuGou",
      "name": "KuGou"
    }
  ]
}
